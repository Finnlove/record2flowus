{
  "manifest_version": 3,
  "name": "FlowUs 语音笔记 (Hex)",
  "version": "0.2.0",
  "description": "在 FlowUs 页面一键触发 Hex 本地录音，自动转写整理并回传当前页",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FlowUs 语音笔记 (Hex)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://flowus.cn/*",
    "https://*.flowus.cn/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://flowus.cn/*", "https://*.flowus.cn/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
